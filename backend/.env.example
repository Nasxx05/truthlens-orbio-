# TrustLens backend configuration
# Copy to .env and fill in. .env is gitignored and must never be committed.
# All credentials live here on the backend only — never in extension code.

# --- Server ---
LOG_LEVEL=INFO

# --- Review scraping ---
# Hard cap on reviews collected per source. Bounds scrape time and, later, how
# much text is sent to the LLM.
REVIEW_MAX=150
# Below this many reviews, /analyze reports not_enough_data instead of a thin
# summary that would look authoritative and be worthless.
REVIEW_MIN=5
# Pagination ceiling, independent of REVIEW_MAX.
SCRAPE_MAX_PAGES=12
# Per-request and whole-scrape budgets, in seconds.
SCRAPE_TIMEOUT=10
SCRAPE_CONNECT_TIMEOUT=5
SCRAPE_TOTAL_TIMEOUT=45
# Delay between requests to one host.
SCRAPE_DELAY=0.7
SCRAPE_RETRIES=1
# SCRAPE_USER_AGENT=

# Honour robots.txt. Amazon disallows /product-reviews/, so with this on only
# the reviews present on the product page are collected there. Turning it off
# is a decision about how you want this service to behave; it is not the
# default for a reason.
RESPECT_ROBOTS=true

# Browser rendering for client-rendered review widgets. Requires playwright
# plus `python -m playwright install chromium`; falls back to HTTP silently
# when unavailable.
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_TIMEOUT=25

# --- Fake-review filtering ---
FILTER_ENABLED=true
# Suspicion score at or above which a review fails filtering (0..1).
FILTER_THRESHOLD=0.5
# Shingle/token overlap at which two reviews count as near-duplicates.
DUPLICATE_SIMILARITY=0.55
# Precise calendar dates needed before submission clustering is judged at all.
# Below this, clustering is not a pattern and would flag every product with
# few reviews.
PACING_MIN_DATED=8

# --- Video discovery ---
# YouTube Data API v3 key. Without it the YouTube source contributes nothing
# and says so; the rest of the request is unaffected.
# Get one at https://console.cloud.google.com -> enable "YouTube Data API v3".
YOUTUBE_API_KEY=

# Videos shorter than this are clips or shorts, not reviews. Applied to
# YouTube only — TikTok is short-form by design, where a 40-second review is
# normal, so the length filter would remove every result.
VIDEO_MIN_SECONDS=120
VIDEO_MAX_RESULTS=6
VIDEO_RELEVANCE_THRESHOLD=0.45
VIDEO_TIMEOUT=15
# TikTok has no public API and disallows /search in robots.txt, so with
# RESPECT_ROBOTS=true it is skipped with a note. Off by default — YouTube is
# the primary/only video source unless this is explicitly set to true.
TIKTOK_ENABLED=false

# --- LLM provider ---
# Provider is swappable behind the LLMProvider interface: "anthropic" or
# "openai". Set the matching API key below.
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
# Tried if OPENAI_MODEL errors (rate limit, upstream overload, bad response
# shape). Leave blank to disable fallback. Only useful when both models are
# reachable through the same OPENAI_BASE_URL/OPENAI_API_KEY, e.g. two models
# on the same OpenRouter key.
OPENAI_FALLBACK_MODEL=
# Leave blank for OpenAI's own API. Set to an OpenAI-compatible proxy to use
# the "openai" provider with a proxy key instead, e.g. for OpenRouter:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=<your OpenRouter key>
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=qwen/qwen3.8-flash
#   OPENAI_FALLBACK_MODEL=google/gemini-3.8-flash
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# --- Cache (PostgreSQL) ---
# Completed analyses are cached so a second lookup of the same product is
# instant. Leave DATABASE_URL blank to run without a cache: every operation
# degrades to a miss, so the service works either way.
CACHE_ENABLED=true
DATABASE_URL=postgresql://trustlens:trustlens@localhost:5432/trustlens
CACHE_TTL_HOURS=24
# Thin or failed results expire sooner — they usually reflect a transient
# problem, and pinning one for a day would make a product look permanently
# unanalysable.
CACHE_TTL_THIN_HOURS=1
DB_POOL_SIZE=5
DB_TIMEOUT=8

# --- Task queue (Redis) ---
# With a queue, scraping happens in worker processes (`python -m app.worker`)
# instead of on the request path. Without one, analyses run inline.
QUEUE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=5
JOB_TIMEOUT=120
JOB_RESULT_TTL=300
JOB_STREAM_MAXLEN=200
# Concurrent analyses per worker: the real backpressure control.
WORKER_CONCURRENCY=4

# --- Security ---
# Whether the backend may fetch private, loopback or link-local addresses.
# MUST be false in production: leaving it on turns this service into an SSRF
# proxy for anything reachable from its network. It is true here only so the
# local test fixtures on 127.0.0.1 work.
ALLOW_PRIVATE_TARGETS=true
DNS_TIMEOUT=3
# Requests per window per client. Analysis is expensive, so keep this low.
RATE_LIMIT=20
RATE_LIMIT_WINDOW=60
# Only enable behind a proxy that overwrites X-Forwarded-For, or callers can
# forge it and bypass the limit.
TRUST_PROXY_HEADERS=false
MAX_BODY_BYTES=16384

# --- Logging ---
# `json` for structured logs; anything else for readable development output.
# Reviewer names, emails and long bodies are scrubbed either way.
LOG_FORMAT=
